    <bpmn:process id="Process_1" isExecutable="true">
        <bpmn:startEvent id="StartEvent_1" name="Hiring confirmed"/>
        <bpmn:task id="Task_1" name="Initiate onboarding process"/>
        <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
        <bpmn:task id="Task_2" name="Send welcome email"/>
        <bpmn:task id="Task_3" name="Schedule orientation session"/>
        <bpmn:task id="Task_4" name="Upload employee details to HRMS"/>
