        <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_5" targetRef="Task_8"/>
        <bpmn:task id="Task_9" name="Cross-check compliance report"/>
        <bpmn:exclusiveGateway id="Gateway_2"/>
        <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_6" targetRef="Task_9"/>
        <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_9" targetRef="Gateway_2"/>
        <bpmn:sequenceFlow id="Flow_13" sourceRef="Gateway_2" targetRef="EndEvent_1"/>
